pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Getting main branch code'
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        stage('Build') {
            steps {
                echo 'Building production website'
                sh 'test -f index.html'
                echo 'Build successful'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing production website'
                sh 'test -s index.html'
                echo 'Test passed'
            }
        }

        stage('Deploy') {
    steps {
        echo 'Deploying to production'

        sh '''
            mkdir -p /home/harshu/production-server
            cp index.html /home/harshu/production-server/
            ls -l /home/harshu/production-server/
        '''

        echo 'Production deployment completed'
    }
}
    }

    post {
        success {
            echo 'Production pipeline completed successfully'
        }

        failure {
            echo 'Production pipeline failed'
        }
    }
}
